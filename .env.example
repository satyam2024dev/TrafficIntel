# Compose production deployment. Copy to the repository root .env and replace every placeholder.
POSTGRES_DB=traffic_intel
POSTGRES_USER=traffic_intel
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
# URL-encode reserved characters in the password before placing it in DATABASE_URL.
DATABASE_URL=postgresql+asyncpg://traffic_intel:replace-with-url-encoded-password@postgresql:5432/traffic_intel
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
APP_HTTP_PORT=8080
CORS_ORIGINS=["https://traffic.example.com"]
LIVE_CAMERA_ALLOWED_RTSP_HOSTS=
PROCESS_EVERY_N_FRAMES=3
MEDIA_PROCESSING_CONCURRENCY=1
MAX_PENDING_MEDIA_JOBS=20
MAX_LIVE_CAMERA_SESSIONS=2
