# Real-Time Vehicle Route Tracking & All-Weather ANPR Environment Configuration
APP_NAME="Real-Time Vehicle Route Tracking & All-Weather ANPR"
APP_ENV="development"
DEV_AUTH_BYPASS=false
# Exact browser origins allowed to use the temporary bypass (no wildcards).
DEV_AUTH_TRUSTED_ORIGINS=["http://localhost:5173"]
DEBUG=False
API_V1_PREFIX="/api"

# Database Configuration (Supports SQLite local file or PostgreSQL asyncpg)
# Default for zero-config local run:
DATABASE_URL="sqlite+aiosqlite:///./traffic_intel.db"
# Or for Docker / production PostgreSQL:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/traffic_intel"

# Demo Mode & Simulation
DEMO_MODE=True
SIMULATION_INTERVAL_SECONDS=2.0
MEDIA_STORAGE_DIR=backend/storage
MAX_UPLOAD_SIZE_MB=100
MAX_VIDEO_DURATION_SECONDS=600
MAX_IMAGE_SIZE_MB=20
MAX_PENDING_MEDIA_JOBS=20
MEDIA_PROCESSING_CONCURRENCY=1
MEDIA_DEMO_MODE=False
# Relative paths resolve from the repository root.
YOLO_MODEL_PATH=models/yolov8n.pt
PLATE_MODEL_PATH=models/license_plate_detector.pt
PROCESS_EVERY_N_FRAMES=3
TRACKER_LOST_TRACK_BUFFER=30
TRACKER_MINIMUM_CONSECUTIVE_FRAMES=2
TRACKER_MINIMUM_IOU_THRESHOLD=0.1
LIVE_PROCESSING_FPS=2.0
LIVE_FRAME_READ_TIMEOUT_SECONDS=8.0
LIVE_RECONNECT_INITIAL_SECONDS=1.0
LIVE_RECONNECT_MAX_SECONDS=30.0
LIVE_EVENT_DEDUP_SECONDS=30.0
MAX_LIVE_CAMERA_SESSIONS=2
# Comma-separated exact RTSP host/IP allowlist. RTSP configuration is rejected when empty.
LIVE_CAMERA_ALLOWED_RTSP_HOSTS=

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://192.168.29.188:5173", "http://localhost:5174", "http://127.0.0.1:5174", "http://localhost:3000"]

# Security
# Leave empty for development's process-local key. Production must use a random 32+ character key.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
