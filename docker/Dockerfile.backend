FROM python:3.11-slim

WORKDIR /app

# Install system dependencies for OpenCV, libgl, and networking
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    libgl1 \
    libglib2.0-0 \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install
COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY backend/requirements-ai.txt ./requirements-ai.txt
RUN pip install --no-cache-dir -r requirements-ai.txt

# Copy backend and AI engine code
COPY backend ./backend
COPY ai_engine ./ai_engine
COPY database ./database

RUN useradd --system --create-home --uid 10001 anpr \
    && mkdir -p /data/media \
    && chown -R anpr:anpr /data/media

ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
USER anpr

EXPOSE 8000

CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--no-access-log"]
